# Server-side deployment configuration (not a secret).
# Install to /srv/seo-stat/config/seo-stat.env
GITHUB_REPOSITORY=marijustechin/seo-stat
GITHUB_WORKFLOW_FILE=harness.yml
GITHUB_BRANCH=main
GITHUB_API=https://api.github.com
# Path to a minimally scoped GitHub token (fine-grained PAT with Actions: read
# for this repository only). Stored outside Git, mode 0600, never printed.
GITHUB_TOKEN_FILE=/srv/seo-stat/config/github.token

SEO_STAT_ROOT=/srv/seo-stat
SEO_STAT_BASE_PATH=/seo-stat
API_PORT=3011
WEB_PORT=3012
PUBLIC_URL=https://192.168.8.50/seo-stat/
# Certificate used for the HTTPS health check (optional; falls back to -k).
SEO_STAT_TLS_CACERT=/etc/ssl/ai-sdr/ai-sdr.crt
KEEP_RELEASES=5
