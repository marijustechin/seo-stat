[Unit]
Description=seo-stat API (NestJS + Fastify)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/seo-stat/current/apps/api
EnvironmentFile=/srv/seo-stat/config/api.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/node dist/main.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
