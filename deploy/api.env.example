# Install to /srv/seo-stat/config/api.env with mode 0600. Contains a secret.
# The database password is created by the administrator bootstrap and stored
# only here (and in the database), never in Git.
DATABASE_URL=postgresql://seostat:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/seo_stat?schema=public
PORT=3011
NODE_ENV=production

# Website/competitor analysis provider: DeepSeek (server-side only).
# Set DEEPSEEK_API_KEY to enable analysis; leave blank to keep it disabled.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional research backend: Firecrawl. When set, it is preferred to acquire
# page content; otherwise the direct fetch backend is used.
# FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# Optional documented price basis (USD per 1M tokens) for estimated cost,
# from DeepSeek's published pricing.
# ANALYSIS_COST_INPUT_PER_MTOK=
# ANALYSIS_COST_OUTPUT_PER_MTOK=

# Optional article cover-image generation (separate capability and credential
# from the text provider; OpenAI Images). Without a key, covers can only be
# uploaded. Set the asset directory outside the release directory.
# IMAGE_API_KEY=
# OPENAI_IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-2.5-flare
# IMAGE_BASE_URL=https://api.openai.com/v1
CONTENT_ASSET_DIR=/srv/seo-stat/data/content-images
