// seo-stat Prisma schema (Prisma 7).
//
// The connection URL is configured in prisma.config.ts (not in this file).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A project represents a specific business or brand. It owns its settings,
/// content, workflows, schedules, execution history, integrations, metrics, and
/// reports. Identity is the generated `id`, which is stable across name or
/// website changes.
model Project {
  id               String    @id @default(uuid())
  name             String
  description      String?
  websiteUrl       String?   @map("website_url")
  businessContext  String?   @map("business_context")
  audience         String?
  objectives       String?
  contentLanguage  String    @default("en") @map("content_language")
  tone             String?
  timezone         String    @default("Europe/Vilnius")
  publishingPolicy String    @default("review") @map("publishing_policy")
  competitorUrls   String[]  @default([]) @map("competitor_urls")
  status           String    @default("active")
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  analyses         AnalysisRun[]
  topics           ContentTopic[]
  briefs           ArticleBrief[]
  drafts           ArticleDraft[]
  contentRuns      ContentRun[]
  knowledge        ProjectKnowledge[]
  images           ArticleImage[]

  @@index([status])
  @@map("projects")
}

/// A manually triggered, project-scoped analysis of the project website,
/// objectives, and optional competitors. Runs asynchronously; the research input
/// is snapshotted at start and the structured suggestions are stored as JSON.
model AnalysisRun {
  id                       String    @id @default(uuid())
  projectId                String    @map("project_id")
  status                   String    @default("queued")
  inputSnapshot            Json      @map("input_snapshot")
  evidence                 Json?
  result                   Json?
  error                    String?
  provider                 String?
  model                    String?
  inputTokens              Int?      @map("input_tokens")
  outputTokens             Int?      @map("output_tokens")
  estimatedCostUsd         Float?    @map("estimated_cost_usd")
  projectUpdatedAtSnapshot DateTime? @map("project_updated_at_snapshot")
  appliedAt                DateTime? @map("applied_at")
  appliedFields            String[]  @default([]) @map("applied_fields")
  startedAt                DateTime? @map("started_at")
  finishedAt               DateTime? @map("finished_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  project                  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([status])
  @@map("analysis_runs")
}

/// A project-scoped content topic suggestion (generated) or a manual topic.
model ContentTopic {
  id                String       @id @default(uuid())
  projectId         String       @map("project_id")
  title             String
  audience          String
  objective         String
  readerNeed        String?      @map("reader_need")
  angle             String
  callToAction      String?      @map("call_to_action")
  relevance         String?
  informationNeeded String?      @map("information_needed")
  objectiveAlignment String?     @map("objective_alignment")
  priority          String       @default("supporting")
  requirements      Json?
  origin            String       @default("generated")
  status            String       @default("suggested")
  sources           Json?
  generationRunId   String?      @map("generation_run_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brief             ArticleBrief?
  drafts            ArticleDraft[]

  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@map("content_topics")
}

/// One editable article brief per topic.
model ArticleBrief {
  id              String       @id @default(uuid())
  projectId       String       @map("project_id")
  topicId         String       @unique @map("topic_id")
  title           String
  angle           String
  audience        String
  businessOutcome String?      @map("business_outcome")
  outline         String?
  callToAction    String?      @map("call_to_action")
  destinationUrl  String?      @map("destination_url")
  sources         Json?
  confirmations   Json?
  answers         Json?
  settingsSnapshot Json?       @map("settings_snapshot")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic           ContentTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  drafts          ArticleDraft[]

  @@map("article_briefs")
}

/// A versioned article draft for a topic. Regeneration appends a new version.
model ArticleDraft {
  id               String        @id @default(uuid())
  projectId        String        @map("project_id")
  topicId          String        @map("topic_id")
  briefId          String?       @map("brief_id")
  version          Int           @default(1)
  status           String        @default("draft")
  title            String?
  excerpt          String?
  bodyMarkdown     String        @map("body_markdown")
  slug             String?
  seoTitle         String?       @map("seo_title")
  metaDescription  String?       @map("meta_description")
  callToAction     String?       @map("call_to_action")
  sources          Json?
  unresolvedClaims Json?         @map("unresolved_claims")
  settingsSnapshot Json?         @map("settings_snapshot")
  briefSnapshot    Json?         @map("brief_snapshot")
  generationRunId  String?       @map("generation_run_id")
  savedAt          DateTime?     @map("saved_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic            ContentTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  brief            ArticleBrief?  @relation(fields: [briefId], references: [id], onDelete: SetNull)
  images           ArticleImage[]

  @@unique([topicId, version])
  @@index([projectId, createdAt])
  @@map("article_drafts")
}

/// Reusable, user-provided project knowledge promoted from a topic answer.
model ProjectKnowledge {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  text           String
  originQuestion String?  @map("origin_question")
  originTopicId  String?  @map("origin_topic_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_knowledge")
}

/// A cover image for an article draft (generated or uploaded). Files are stored
/// outside release directories (see CONTENT_ASSET_DIR).
model ArticleImage {
  id          String        @id @default(uuid())
  projectId   String        @map("project_id")
  draftId     String?       @map("draft_id")
  version     Int           @default(1)
  kind        String        @default("generated")
  status      String        @default("ready")
  prompt      String?
  altText     String?       @map("alt_text")
  provider    String?
  model       String?
  fileName    String?       @map("file_name")
  mimeType    String?       @map("mime_type")
  width       Int?
  height      Int?
  bytes       Int?
  storagePath String?       @map("storage_path")
  usage       Json?
  selected    Boolean       @default(false)
  error       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  draft       ArticleDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([draftId])
  @@map("article_images")
}

/// Asynchronous topic/article generation executions (distinct from analyses).
model ContentRun {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  kind             String
  topicId          String?   @map("topic_id")
  draftId          String?   @map("draft_id")
  status           String    @default("queued")
  inputSnapshot    Json      @map("input_snapshot")
  evidence         Json?
  result           Json?
  error            String?
  provider         String?
  model            String?
  inputTokens      Int?      @map("input_tokens")
  outputTokens     Int?      @map("output_tokens")
  estimatedCostUsd Float?    @map("estimated_cost_usd")
  startedAt        DateTime? @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([status])
  @@map("content_runs")
}
