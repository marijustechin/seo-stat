// seo-stat Prisma schema (Prisma 7).
//
// The connection URL is configured in prisma.config.ts (not in this file).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A project represents a specific business or brand. It owns its settings,
/// content, workflows, schedules, execution history, integrations, metrics, and
/// reports. Identity is the generated `id`, which is stable across name or
/// website changes.
model Project {
  id               String    @id @default(uuid())
  name             String
  description      String?
  websiteUrl       String?   @map("website_url")
  businessContext  String?   @map("business_context")
  audience         String?
  objectives       String?
  contentLanguage  String    @default("en") @map("content_language")
  tone             String?
  timezone         String    @default("Europe/Vilnius")
  publishingPolicy String    @default("review") @map("publishing_policy")
  competitorUrls   String[]  @default([]) @map("competitor_urls")
  status           String    @default("active")
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  analyses         AnalysisRun[]

  @@index([status])
  @@map("projects")
}

/// A manually triggered, project-scoped analysis of the project website,
/// objectives, and optional competitors. Runs asynchronously; the research input
/// is snapshotted at start and the structured suggestions are stored as JSON.
model AnalysisRun {
  id                       String    @id @default(uuid())
  projectId                String    @map("project_id")
  status                   String    @default("queued")
  inputSnapshot            Json      @map("input_snapshot")
  evidence                 Json?
  result                   Json?
  error                    String?
  provider                 String?
  model                    String?
  inputTokens              Int?      @map("input_tokens")
  outputTokens             Int?      @map("output_tokens")
  estimatedCostUsd         Float?    @map("estimated_cost_usd")
  projectUpdatedAtSnapshot DateTime? @map("project_updated_at_snapshot")
  appliedAt                DateTime? @map("applied_at")
  appliedFields            String[]  @default([]) @map("applied_fields")
  startedAt                DateTime? @map("started_at")
  finishedAt               DateTime? @map("finished_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  project                  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([status])
  @@map("analysis_runs")
}
