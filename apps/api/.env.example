# Copy this file to apps/api/.env and adjust as needed.
# .env is git-ignored. The values below are local development defaults for the
# docker-compose.yml database and are not secrets.
DATABASE_URL="postgresql://seostat:seostat@127.0.0.1:5433/seo_stat?schema=public"

# Port the NestJS API listens on (loopback only in the application).
PORT=3011

# Website/competitor analysis provider (server-side only; never sent to the
# browser). When OPENAI_API_KEY is unset, analysis is "not configured" and the
# UI shows an unavailable state. See docs/deployment.md.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
# OPENAI_BASE_URL=

# Optional documented price basis for estimated cost (USD per 1M tokens).
# Without these, cost is reported as unavailable rather than zero.
# ANALYSIS_COST_INPUT_PER_MTOK=2
# ANALYSIS_COST_OUTPUT_PER_MTOK=10
