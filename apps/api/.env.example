# Copy this file to apps/api/.env and adjust as needed.
# .env is git-ignored. The values below are local development defaults for the
# docker-compose.yml database and are not secrets.
DATABASE_URL="postgresql://seostat:seostat@127.0.0.1:5433/seo_stat?schema=public"

# Port the NestJS API listens on (loopback only in the application).
PORT=3011

# Website/competitor analysis provider: DeepSeek (server-side only; never sent
# to the browser). When DEEPSEEK_API_KEY is unset, analysis is "not configured"
# and the UI shows an unavailable state. See docs/deployment.md.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional research backend: Firecrawl. When FIRECRAWL_API_KEY is set, Firecrawl
# is preferred to acquire page content as clean Markdown; otherwise the direct
# fetch backend is used.
# FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Optional documented price basis for estimated cost (USD per 1M tokens), set
# from DeepSeek's published pricing. Without these, cost is reported as
# unavailable rather than zero.
# ANALYSIS_COST_INPUT_PER_MTOK=
# ANALYSIS_COST_OUTPUT_PER_MTOK=

# Article cover-image generation. Provider selection is explicit: only
# IMAGE_PROVIDER=cloudflare or IMAGE_PROVIDER=openai enable generation; unset or
# unknown disables it (image uploads still work). A stray IMAGE_API_KEY does NOT
# enable or fall back to OpenAI. The DeepSeek text provider is unaffected.
#
# Cloudflare Workers AI (recommended for the Workers Free plan): FLUX.1 [schnell].
# The REST call is POST .../accounts/{accountId}/ai/run/@cf/black-forest-labs/flux-1-schnell
# with Bearer auth, a prompt (max 2048 chars) and steps (1-8, default 4).
# IMAGE_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# IMAGE_STEPS=4
#
# OpenAI Images (only used when IMAGE_PROVIDER=openai).
# IMAGE_API_KEY=
# OPENAI_IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-2.5-flare
# IMAGE_BASE_URL=https://api.openai.com/v1

# Directory that stores generated/uploaded cover images. Must be outside the
# release directory so assets survive deployments.
# CONTENT_ASSET_DIR=/srv/seo-stat/data/content-images

# Deployment-managed key for authenticated encryption (AES-256-GCM) of stored
# integration credentials (WordPress Application Passwords). 32 bytes as hex or
# base64. The file lives outside the release directories (mode 0600). When unset,
# integration credentials cannot be stored or read.
# INTEGRATION_ENCRYPTION_KEY=
# INTEGRATION_ENCRYPTION_KEY_FILE=/srv/seo-stat/config/integration.key
